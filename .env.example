# ---------------------------------------------------------------------------
# Taskora — environment variables
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/taskora?retryWrites=true&w=majority

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string

# Base URL of the app (no trailing slash)
APP_URL=http://localhost:3000

# Secret for the Vercel Cron endpoint (/api/cron/notify) — generate like JWT_SECRET
CRON_SECRET=replace_with_another_long_random_hex_string

# Email: set to "true" to actually send, "false" to log emails to the console
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="Taskora <noreply@taskora.app>"

# First admin created by `npm run seed`
SEED_ADMIN_NAME=Your Name
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_min_6_chars
